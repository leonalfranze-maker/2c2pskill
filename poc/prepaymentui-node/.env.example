# Copy to .env and fill in. NEVER commit .env.

# UAT or PRD
PACO_ENV=UAT

# Issued by 2C2P when your company is registered on PACO.
# PACO_API_KEY is sent in the "apiKey" header (and as the JWT "iss"). No other auth header is used.
PACO_API_KEY=
PACO_OFFICE_ID=

# UAT only, for debugging: send plain JSON instead of JOSE (the 4 keys below are then optional).
# Production REJECTS plain JSON. Turn this off and test with JOSE before go-live.
PACO_UAT_PLAIN_JSON=false

# Default currency
PACO_CURRENCY=THB

# Public URL of THIS server. PACO must reach <PUBLIC_BASE_URL>/paco/notification from the internet.
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Your private keys (npm run keys). PEM on one line with \n, or bare Base64 PKCS#8.
MERCHANT_SIGNING_PRIVATE_KEY=
MERCHANT_ENCRYPTION_PRIVATE_KEY=

# PACO public keys (from the 2C2P-JOSE-Key-UAT.zip / PRD.zip). PEM or bare Base64 X.509.
PACO_ENCRYPTION_PUBLIC_KEY=
PACO_SIGNING_PUBLIC_KEY=

# Optional overrides (defaults come from the Dev Zone Integration page)
# PACO_BASE_URL=https://core.demo-paco.2c2p.com
# PACO_KEY_ID=7664a2ed0dee4879bdfca0e8ce1ac313
