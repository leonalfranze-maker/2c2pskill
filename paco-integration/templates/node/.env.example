# Copy to .env (cp .env.example .env) and fill in. NEVER commit .env or share it in chat.

# UAT (sandbox) or PRD (production). UAT and PRD use different credentials and keys.
PACO_ENV=UAT

# From 2C2P onboarding. The API key (32 hex characters) goes in the "apiKey" header and the JWT "iss".
PACO_API_KEY=
PACO_OFFICE_ID=

# ISO 4217 alphabetic code your office is set up for (THB, not 764). See references/currencies.md.
PACO_CURRENCY=THB

# Public URL of THIS server. PACO posts results to <PUBLIC_BASE_URL>/paco/notification.
# localhost works for redirects; PACO can't reach it for notifications (results are confirmed by Inquiry anyway).
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# UAT only, for the very first call: send plain JSON instead of JOSE (then the keys below are optional).
# Production rejects plain JSON. Switch this off and test again with JOSE before go-live.
PACO_UAT_PLAIN_JSON=false

# JOSE keys. Give either the value (NAME=...) or a file path (NAME_FILE=...).
# Your private keys: run `npm run keys`, then uncomment these two lines. Never share the keys.
# MERCHANT_SIGNING_PRIVATE_KEY_FILE=keys/merchant-signing-private.pem
# MERCHANT_ENCRYPTION_PRIVATE_KEY_FILE=keys/merchant-encryption-private.pem
# PACO's public keys: from 2C2P (PEM or bare Base64).
PACO_ENCRYPTION_PUBLIC_KEY=
PACO_SIGNING_PUBLIC_KEY=
# PACO key ID (kid) from 2C2P. Defaults: the UAT/PRD values on the Dev Zone Integration page.
# PACO_KEY_ID=

# Optional: override the API base URL (defaults: UAT core.demo-paco.2c2p.com, PRD core.paco.2c2p.com)
# PACO_BASE_URL=
